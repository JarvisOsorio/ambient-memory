{
  "name": "ambient-memory",
  "version": "0.2.1",
  "description": "Zero-config ambient memory — local daemon + MCP server that remembers what you worked on",
  "type": "module",
  "bin": {
    "ambient": "./bin/ambient.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "bin/",
    "dist/src/",
    "dist/scripts/",
    "packaging/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "ambient": "node ./bin/ambient.js",
    "test": "npm run build && node --test --test-reporter=spec dist/test/unit/*.test.js dist/test/integration/*.test.js",
    "demo": "npm run build && node ./dist/scripts/demo.js",
    "start": "node ./bin/ambient.js start",
    "mcp": "node ./bin/ambient.js mcp",
    "doctor": "node ./bin/ambient.js doctor",
    "pack:release": "npm run build && node ./scripts/pack-release.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "keywords": [
    "mcp",
    "memory",
    "local-first",
    "ambient",
    "ai-context",
    "cursor"
  ],
  "author": "JarvisOsorio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JarvisOsorio/ambient-memory.git"
  },
  "bugs": {
    "url": "https://github.com/JarvisOsorio/ambient-memory/issues"
  },
  "homepage": "https://github.com/JarvisOsorio/ambient-memory#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.9.1",
    "chokidar": "^4.0.3",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
